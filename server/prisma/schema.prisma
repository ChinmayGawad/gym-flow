generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user") // "admin" | "user"
  plan          String    @default("basic") // "basic" | "pro" | "elite"
  planStatus    String    @default("active") // "active" | "expired" | "pending"
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    Int?
  isCheckedIn   Boolean   @default(false)
  lastCheckInAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  visitLogs     VisitLog[]
  plannedVisits PlannedVisit[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
  @@index([identifier])
}

model GymSettings {
  id        String   @id @default("default")
  capacity  Int      @default(30)
  gymName   String   @default("GymFlow Fitness")
  updatedAt DateTime @updatedAt

  @@map("gym_settings")
}

model OccupancyLog {
  id             String   @id @default(cuid())
  occupantsCount Int
  capacity       Int      @default(30)
  timestamp      DateTime @default(now())

  @@map("occupancy_log")
}

model VisitLog {
  id              String    @id @default(cuid())
  userId          String
  checkInTime     DateTime  @default(now())
  checkOutTime    DateTime?
  durationMinutes Int?
  workoutType     String?   @default("General Strength & Conditioning")
  caloriesBurned  Int?      @default(300)
  notes           String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("visit_log")
  @@index([userId])
}

model PlannedVisit {
  id            String   @id @default(cuid())
  userId        String
  scheduledDate String   // ISO date string: YYYY-MM-DD
  timeSlot      String   // e.g. "11:00 AM", "6:00 PM"
  hour24        Int      // 6 to 22
  workoutFocus  String?  @default("General Strength & Conditioning")
  notes         String?
  status        String   @default("planned") // "planned" | "completed" | "cancelled"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("planned_visit")
  @@index([userId])
  @@index([scheduledDate, hour24])
}

