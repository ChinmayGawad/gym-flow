{
  "name": "@gymflow/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bunx prisma generate && bun build src/index.ts --target=bun --outdir=dist",
    "start": "bunx prisma db push --accept-data-loss && bun src/index.ts",
    "create-admin": "bun src/scripts/create-admin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@gymflow/core": "workspace:*",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.7.1",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
